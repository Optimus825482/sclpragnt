# ============================================================================
# SCALPERNEW .env şablonu — bu dosyayı `.env` olarak kopyalayıp doldurun.
#   copy .env.example .env   (sonra değerleri girin)
# `.env` GIT'E EKLENMEZ (secret). Coolify kullanıyorsanız bu değerleri
# panelde "Environment Variables" olarak girin.
# ============================================================================

# --- Postgres (YENİ, temiz veritabanı: adı scalpernew) ----------------------
POSTGRES_DB=scalpernew
POSTGRES_USER=scalpernew
# Güçlü parola üret: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Yönetici oturumu (ÜRETİM politikası: >=10 karakter, sadece rakam değil) -
SCALPER_ENV=production
SCALPER_ADMIN_PASSWORD=
SCALPER_SESSION_SECRET=

# --- LLM anahtar şifreleme (Fernet 32 bayt base64) ---------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=
LLM_ALLOW_PRIVATE_PROVIDER=0

# --- Davranış ----------------------------------------------------------------
LIVE_TRADING=false
TZ=Europe/Istanbul
TOP_GAINERS_AUTO_ACTIVATE=true
TOP_GAINERS_LIMIT=10
TOP_GAINERS_REFRESH_SEC=600
GLOBAL_SCAN_ENABLED=true
GLOBAL_SCAN_INTERVAL_SEC=30

# --- WhatsApp (varsayılan KAPALI; açarsanız köprüyü QR ile eşleştirin) -------
WHATSAPP_NOTIFY_ENABLED=false
WHATSAPP_HOURLY_ENABLED=false
WHATSAPP_BRIDGE_KEY=
WHATSAPP_GROUP_ID=

# --- Web Push (opsiyonel) ----------------------------------------------------
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
