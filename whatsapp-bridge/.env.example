# WhatsApp köprüsü yapılandırması (örnek). Kopyala: cp .env.example .env
PORT=3001
# Paylaşılan anahtar — backend'deki WHATSAPP_BRIDGE_KEY ile AYNI olmalı
BRIDGE_KEY=degistir-uzun-rastgele-anahtar
# Grup ID — köprü bağlandıktan sonra `GET /groups` ile bul
WHATSAPP_GROUP_ID=
# Log seviyesi: silent (önerilen — yalnız kritik satırlar) | warn | info | debug
# Baileys'in JSON gürültüsünü (stream error / init queries timeout) görmek
# istemiyorsan silent/warn kullan. Sorun ayıklarken debug.
LOG_LEVEL=silent
