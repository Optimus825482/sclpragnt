# WhatsApp köprüsü yapılandırması (örnek). Kopyala: cp .env.example .env
PORT=3001
# ZORUNLU. Paylaşılan anahtar — backend'deki WHATSAPP_BRIDGE_KEY ile AYNI olmalı.
# Boşsa köprü başlamaz (denetim 2026-10-15). Üret: openssl rand -hex 32
BRIDGE_KEY=degistir-uzun-rastgele-anahtar
# Grup ID — köprü bağlandıktan sonra `GET /groups` ile bul
WHATSAPP_GROUP_ID=
# Mesaj gönderilebilecek EK hedefler (virgüllü): grup JID'i (…@g.us) veya telefon
# numarası (ülke koduyla, örn. 905551234567). Grup ID dışındaki her `to` reddedilir.
WHATSAPP_ALLOWED_RECIPIENTS=
# Log seviyesi: silent (önerilen — yalnız kritik satırlar) | warn | info | debug
# Baileys'in JSON gürültüsünü (stream error / init queries timeout) görmek
# istemiyorsan silent/warn kullan. Sorun ayıklarken debug.
LOG_LEVEL=silent
