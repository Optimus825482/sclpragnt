# ─────────────────────────────────────────────────────────────────────────
# Scalper Agent V4 — örnek ortam değişkenleri.
# Bu dosyayı `.env` olarak KOPYALAYIP doldurun; `docker compose` kök `.env`i
# otomatik okur. GERÇEK DEĞER ASLA BU DOSYAYA YAZILMAZ — yalnızca placeholder.
# .env git-ignored'dır. Coolify'da aynı anahtarlar panelden verilir.
# ─────────────────────────────────────────────────────────────────────────

# Production requires unique, high-entropy values for every secret below.
POSTGRES_DB=scalper
POSTGRES_USER=scalper
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# 2026-10-07 (P1-11 #1): ÜRETİM MODU VARSAYILANDIR. "production" iken
# `config.py` zayıf SCALPER_ADMIN_PASSWORD ile başlatmayı REDDEDER
# (>=10 karakter, tamamen rakam değil, yaygın sözlük değeri değil).
# Yerel geliştirmede politikayı kapatmak için burayı `development` yapın;
# ÜRETİMDE ASLA düşürmeyin. (docker-compose.yaml varsayılanı da production.)
SCALPER_ENV=production

SCALPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SCALPER_SESSION_SECRET=replace-with-at-least-32-random-bytes
SCALPER_COOKIE_SECURE=1

# 2026-09-26 denetim (#105): A2A_SHARED_SECRET / A2A_RELAY_URL / A2A_PEER_URL /
# SCALPER_A2A_URL değişkenleri BURADAN SİLİNDİ.
#
# Gerekçe: A2A (agent-to-agent) modülü tamamen kaldırılmış; `backend/app/`
# altında "A2A" geçen HİÇBİR Python dosyası yok (grep ile doğrulandı). Bu
# dört satır ölüydü. Özellikle `A2A_SHARED_SECRET` orada bırakmak kullanıcıya
# YANLIŞ güvenlik izlenimi veriyordu — sanki bir kimlik doğrulama katmanı
# varmış gibi. Artık A2A için yapılandırılacak bir şey yoktur.
#
# Gerçek üretim kapısı `SCALPER_ENV=production` ile admin parola politikasının
# UYGULANMASIDIR (bkz. docker-compose.yaml ve config.py:751).

# Custom private/LAN providers are rejected unless this is explicitly 1.
LLM_ALLOW_PRIVATE_PROVIDER=0
# ZORUNLU (compose `${LLM_ENCRYPTION_KEY:?...}`): 32 bayt = 64 hex karakter.
# Üretimi: python -c "import os;print(os.urandom(32).hex())"
LLM_ENCRYPTION_KEY=

VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

TOP_GAINERS_AUTO_ACTIVATE=true
TOP_GAINERS_LIMIT=10
TOP_GAINERS_REFRESH_SEC=600

# ── BINANCE TR LEAD-LAG SIGNAL BRIDGE RECEIVER ──────────────────────────────
# 2026-10-07 (P1-11 #3): VARSAYILANLAR GÜVENLİ TARAF ÇEVRİLDİ.
# Eskiden alıcı AÇIK + PLACEHOLDER secret + AUTO_TRADE=true geliyordu; örnek
# dosyayı kopyalayan operatör farkında olmadan otomatik işlem açabiliyordu.
# Artık: alıcı KAPALI, otomatik işlem KAPALI, gerçek secret ZORUNLU (alıcıyı
# açarsanız boş secretla her istek 401 döner ve yükseltme yapılmaz).
#
# Alıcıyı AÇMAK için: aşağıdaki secret'ı güçlü rastgele bir değerle doldurun,
# ardından BINANCE_TR_RECEIVER_ENABLED=1 yapın. AUTO_TRADE'i (1) yalnızca
# köprüye güvendiğinizde açın — açıkken gelen sinyaller doğrudan paper işlem
# açar.
BINANCE_TR_BRIDGE_SECRET=
BINANCE_TR_RECEIVER_ENABLED=0
BINANCE_TR_BRIDGE_AUTO_TRADE=0
BINANCE_TR_BRIDGE_MIN_SCORE=0.0
# DİKKAT: alıcı >10 sn gerektirir; 10.0 ve altı 60.0'a yükseltilir.
BINANCE_TR_BRIDGE_COOLDOWN_SEC=60.0

# ── OTOMATİK YEDEK (db-backup servisi) ──────────────────────────────────────
# 2026-10-07 (P2-12): Yedeklerin host DIŞINA kopyalanması ve saklama sayısı
# buradan yönetilir. Varsayılan (aynı disk, 2 dump) tek-disk arızasına karşı
# KORUMAZ; üretimde ikinci disk/NFS/S3 bağlayın.
BACKUP_RETENTION=2
# Host dışı kopya: BACKUP_OFFBOX_DIR'i host'ta ikinci bir diske/NFS'e
# yönlendirip bu bayrağı 1 yapın (off-box volume /offbox'a mount edilir).
BACKUP_OFFBOX_DIR=./offbox_backups
BACKUP_OFFBOX_ENABLED=0
# Kapsamlı alternatif: serbest kabuk komutu. $DUMP = dump dosyası yolu.
# Örn (rclone kuruluysa): BACKUP_REMOTE_CMD=rclone copy "$DUMP" uzak:scalper/
BACKUP_REMOTE_CMD=

# ─────────────────────────────────────────────────────────────────────────
# DOCKER SECRETS (dosya tabanlı) — İLERİ DÜZEY, opsiyonel.
#
# Coolify "Secret Files" / Docker `secrets:` / /run/secrets/* dosyaları
# üretir; ilgili DEĞİŞKEN YERİNE `X_FILE=/run/secrets/...` verilir.
# Coolify panelinde bu dosyalar mount edilip şu anahtarlar tanımlanır:
#
#   SCALPER_ADMIN_PASSWORD_FILE=/run/secrets/scalper_admin_password
#   SCALPER_SESSION_SECRET_FILE=/run/secrets/scalper_session_secret
#   LLM_ENCRYPTION_KEY_FILE=/run/secrets/llm_encryption_key
#   BINANCE_TR_BRIDGE_SECRET_FILE=/run/secrets/bridge_secret
#
# ÖN KOŞUL: dosya-istemcisi deseni `backend/app/config.py`'da olmalıdır
# (`X = os.getenv("X") or _read_secret_file(os.getenv("X_FILE"))`). Bu
# eklenene kadar yalnızca yukarıdaki env-yolu tam çalışır. Ayrıntı ve kesin
# satırlar docker-compose.yaml'daki "secret" yorumunda.
# ─────────────────────────────────────────────────────────────────────────
